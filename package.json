{
  "name": "reverse-harness",
  "version": "0.1.1",
  "description": "Be a model on TrustedRouter: front a local model server, a local agent, or yourself at a keyboard \u2014 signed, streamed, paid per token.",
  "type": "module",
  "bin": {
    "reverse-harness": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "human-in-the-loop",
    "llm",
    "marketplace",
    "ollama",
    "openai",
    "openai-compatible",
    "sse",
    "trustedrouter"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lore-Hex/reverse-harness.git"
  },
  "bugs": {
    "url": "https://github.com/Lore-Hex/reverse-harness/issues"
  },
  "homepage": "https://trustedrouter.com/docs/user-models",
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
